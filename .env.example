# Optional: enables AI vision verification.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini

# Shopify Admin API
# Example: your-store.myshopify.com
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Search behaviour
MAX_CANDIDATES=8
MIN_WIDTH=500
MIN_HEIGHT=500
MIN_WHITE_RATIO=0.45
REQUEST_TIMEOUT=20
SLEEP_BETWEEN_PRODUCTS=1.2
